# Reference only; do not commit a populated .env or real credentials.
APP_ENV=development
SERVER_PORT=8080
# Only an authorized local MySQL 8.4 instance, never the third-party reference ZIP database.
DB_URL=jdbc:mysql://127.0.0.1:3306/urban_commute?connectionTimeZone=UTC
DB_USER=urban_commute
DB_PASSWORD=EXAMPLE_ONLY_REPLACE_LOCALLY
# Optional catalog filter for isolated empty-result tests; not data provisioning.
CITY_DATASET_FILTER=
# Frontend stays same-origin via the Vite dev proxy. Never expose DB credentials as VITE_*.
# S8: optional explicit bootstrap; no accounts are created when all four are absent.
# Supply actual values only as private process environment, never in a committed file.
# COMMUTE_BOOTSTRAP_ADMIN_USER=
# COMMUTE_BOOTSTRAP_ADMIN_PASSWORD=
# COMMUTE_BOOTSTRAP_READER_USER=
# COMMUTE_BOOTSTRAP_READER_PASSWORD=
# COMMUTE_PYTHON=absolute-path-to-project-ml-venv-python
# COMMUTE_BRIDGE=absolute-path-to-scripts/s8_adapter_bridge.py
COMMUTE_PRIVATE_ROOT=data/private/s8
# Prefer a dedicated non-public directory owned by the application account.
# COMMUTE_UPLOAD_TMP=absolute-private-multipart-directory
# false for loopback HTTP only; true is required for an authorized HTTPS deployment.
COMMUTE_COOKIE_SECURE=false
