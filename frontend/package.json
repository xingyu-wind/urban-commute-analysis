    "test:watch": "vitest",
    "test:e2e": "node scripts/verify-integration.mjs"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
